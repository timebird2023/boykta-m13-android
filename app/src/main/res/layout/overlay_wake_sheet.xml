<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="#0F172A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <com.boykta.assistant.ui.BoyktaRobotView
        android:id="@+id/wakeSheetRobot"
        android:layout_width="64dp"
        android:layout_height="64dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWakeSheetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بويكتا يسمعك..."
            android:textColor="#10B981"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWakeSheetHeard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تفضل، أخبرني بما تريد تنفيذه..."
            android:textColor="#F1F5F9"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnWakeSheetClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="✕"
        android:textColor="#94A3B8"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
