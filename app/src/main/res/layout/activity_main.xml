<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بويكتا M13 — رفيقك الذكي 24/24"
            android:textColor="#F1F5F9"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.boykta.assistant.ui.BoyktaRobotView
            android:id="@+id/robotView"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLiveMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#064E3B"
            android:padding="12dp"
            android:text="حالة المستشعر: اضغط «تشغيل بويكتا 24/24» ثم قل «بويكتا»..."
            android:textColor="#ECFDF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111827"
            android:padding="14dp"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTtsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#451A03"
            android:padding="12dp"
            android:text="لتسمع بويكتا ينطق بالعربية الفصحى بوضوح تام: اضغط على زر «تحميل الصوت الفصيح عالي الدقة (Miro V2 · 64MB)»."
            android:textColor="#FDE68A"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartBoykta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:text="تشغيل بويكتا 24/24"
                android:textColor="#042F2E"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopBoykta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="إيقاف الخدمة" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTeachWakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0284C7"
            android:text="🎯 علّمني نطقي لكلمة بويكتا (اضغط وقل «بويكتا» الآن)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDownloadMiroVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#059669"
            android:text="✨ تحميل الصوت الفصيح عالي الدقة (Miro V2 · 64MB — واضح 100%)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleTtsSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1E293B"
            android:text="🔊 مصدر النطق: صوت بويكتا المدمج الفصيح (اضغط للتبديل لصوت النظام)"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDownloadMoonshine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7C3AED"
            android:text="🧠 تحميل محرك السمع الذكي Moonshine (114MB — يفهمك بلا أخطاء)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDownloadFusha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="تحميل حزمة Vosk الفصحى الإضافية (318MB)" />

        <Button
            android:id="@+id/btnDownloadDarija"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="تحميل حزمة Vosk الدارجة الإضافية (158MB)" />

        <ProgressBar
            android:id="@+id/progressDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDownloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGrantPermissions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="أذونات الهاتف"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAccessibilityPermission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="التحكم الشامل"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSystemWritePermission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="إذن السطوع"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تفعيل نافذة بويكتا المنبثقة فوق التطبيقات (مثل OK Google)"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStoragePermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#1E293B"
            android:text="💾 حفظ الحزم بشكل دائم (/BoyktaModels) حتى لا تعيد التحميل"
            android:textColor="#FDE68A"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNotifListenerPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#0F172A"
            android:text="📩 تفعيل مراقب الرسائل غير المقروءة"
            android:textColor="#93C5FD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleIdleRadioGuard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#0F172A"
            android:text="🔋 حارس البلوتوث والواي فاي: إغلاق وتنبيه تلقائي"
            android:textColor="#A7F3D0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="اسمك الشخصي (ليناديك به بويكتا في التذكيرات والأوامر):"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#111827"
                android:hint="اكتب اسمك (مثلاً: يونس)"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B" />

            <Button
                android:id="@+id/btnSaveUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#10B981"
                android:text="حفظ الاسم"
                android:textColor="#042F2E"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="منبه بويكتا الناطق (اكتب ما يقوله لك في الموعد):"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etReminderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#111827"
            android:hint="مثال: روح جدد الاستضافة تاعك راها توقفت"
            android:padding="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReminderTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#111827"
                android:hint="الوقت (18:30 أو 15 دقيقة)"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B" />

            <Button
                android:id="@+id/btnAddReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#0284C7"
                android:text="ضبط التذكير"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnClearReminders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#334155"
                android:text="مسح"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRemindersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0F172A"
            android:padding="10dp"
            android:text="لا توجد تذكيرات نشطة حالياً."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="تجربة سريعة لأوامر بويكتا الفورية:"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipFreeFire"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="فري فاير"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipScreenshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="لقطة شاشة"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="الساعة الآن"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipCleanRam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="نظف الرام"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="الشحن"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipTestWake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="نداء بويكتا"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etCommandTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#111827"
            android:hint="جرب: بويكتا شحال ساعة، أو دير لقطة شاشة"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnRunCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تنفيذ والرد بالعربية الفصحى" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#111827"
            android:minHeight="90dp"
            android:padding="12dp"
            android:text="سجل الأوامر والردود سيظهر هنا..."
            android:textColor="#10B981"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="أضف أمراً مخصصاً من الهاتف مباشرة:"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCustomTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#111827"
            android:hint="العبارة المنطوقة (مثلاً: كيف حالك)"
            android:padding="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/etCustomReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#111827"
            android:hint="رد بويكتا بالعربية الفصحى"
            android:padding="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnSaveCustomRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="حفظ الأمر في الهاتف" />

    </LinearLayout>
</ScrollView>
